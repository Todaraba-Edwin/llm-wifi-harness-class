# Names only. Site core (read-only wiki) needs no environment variables.
# Q&A lane (owner-only) variables, Production scope, none NEXT_PUBLIC_*:
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
OWNER_GITHUB_ID=
OPENAI_API_KEY=
# Blank means the default model (gpt-6-luna).
OPENAI_MODEL=
# Blank means unset (daily cap 50). 0 = unlimited, honored only by a local `next dev`; rejected everywhere else.
QA_DAILY_CAP=
# true = anyone can ask without signing in (the daily cap is shared by all visitors). Blank = owner-only.
QA_PUBLIC=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GITHUB_REPO=
GH_WRITEBACK_TOKEN=
BETTER_AUTH_URL=
