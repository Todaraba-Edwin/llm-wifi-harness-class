{
  "name": "harness-wiki-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "predev": "tsx scripts/build-content.ts",
    "dev": "next dev",
    "build-content": "tsx scripts/build-content.ts",
    "lint:wiki": "tsx scripts/lint-wiki.ts",
    "lint:secret-names": "tsx scripts/lint-secret-names.ts",
    "lint:titles": "tsx scripts/lint-display-titles.ts",
    "lint:raw": "tsx scripts/lint-raw-access.ts",
    "lint": "tsx scripts/lint-raw-access.ts && eslint .",
    "pretypecheck": "tsx scripts/build-content.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "tsx scripts/build-content.ts",
    "test": "vitest run",
    "build": "tsx scripts/build-content.ts && tsx scripts/lint-raw-access.ts && next build && tsx scripts/verify-build.ts",
    "start": "next start",
    "e2e": "playwright test",
    "verify:build": "tsx scripts/verify-build.ts",
    "verify:selftest": "tsx scripts/verify-build.ts --selftest",
    "verify:live": "tsx scripts/verify-live.ts",
    "check:baseline": "tsx scripts/check-baseline.ts",
    "gate:clean": "tsx scripts/clean-gate.ts",
    "check:deploy-env": "tsx scripts/check-deploy-env.ts"
  },
  "dependencies": {
    "@octokit/rest": "22.0.1",
    "@upstash/redis": "1.41.0",
    "better-auth": "1.7.17",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "entities": "^9.0.0",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.2.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "openai": "7.50.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/d3-drag": "^3.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.0",
    "@types/d3-zoom": "^3.0.0",
    "@types/mdast": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "msw": "3.0.3",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
